<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>CSharp.UI.NativeEditReference</RootNamespace>
    <AssemblyName>CSharp.UI.NativeEditReference</AssemblyName>
    <IsPackable>false</IsPackable>
    <!-- 仅对照工具 exe：PerMonitorV2 DPI awareness；生产宿主与系统设置不改。 -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- 窗口过程 / SendMessage 参数与子窗口布局需要 unsafe 指针。 -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- 工具只在 Windows 上有意义；保留 net10.0 目标使其它平台仍能编译（运行时会拒绝）。 -->
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- 复用已审核的 ProbeLog / ScreenCapture / NativeMethods / InputScript；不引用生产 CSharp.UI 程序集。 -->
    <ProjectReference Include="..\CSharp.UI.ImeProbe\CSharp.UI.ImeProbe.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CSharp.UI.NativeEditReference.Tests" />
  </ItemGroup>

</Project>
