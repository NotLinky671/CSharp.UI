<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>CSharp.UI.TsfHostBridgeCheck</RootNamespace>
    <AssemblyName>CSharp.UI.TsfHostBridgeCheck</AssemblyName>
    <IsPackable>false</IsPackable>
    <NuGetAudit>false</NuGetAudit>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <!--
    TI-07 P3a 正式宿主有序输入验收工具。
    使用正常 ProjectReference 与传递依赖（不再 HintPath / 手工复制 / 禁用 deps 文件）。
  -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\CSharp.UI.OpenTK\CSharp.UI.OpenTK.csproj" />
    <ProjectReference Include="..\..\src\CSharp.UI\CSharp.UI.csproj" />
    <ProjectReference Include="..\..\src\CSharp.UI.Text\CSharp.UI.Text.csproj" />
  </ItemGroup>

</Project>
